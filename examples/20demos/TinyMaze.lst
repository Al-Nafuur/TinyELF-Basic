10 REM RANDOM SCROLLING MAZE
20 CLS: PRINT "RANDOM SCROLLING MAZE"
30 PRINT
40 PRINT "GRAPHICS 0 OR 1 ?"
50 INPUT G
60 IF G=0 THEN GRAPHICS 0: GOTO 80
70 GRAPHICS 1
80 FOR I=0 TO 2000 
90 IF RND(2)=1 THEN PRINT "/";: GOTO 120
100 PRINT "\";
110 FOR T=0 TO 300: NEXT T
120 NEXT I
130 GRAPHICS 32
140 PRINT: PRINT "End!"
