10 REM TinyELF Basic demo
12 REM lower the frame budget so heavy loops keep the TV in sync
14 Q=PEEK(652): Z=PEEK(653): POKE 653,0: POKE 652,100
20 GRAPHICS 0: CLS
30 B=PEEK(1024)
40 FOR R=0 TO 13: POKE 256+R, R*16+12: NEXT R
50 PRINT: PRINT "  T i n y E L F   B A S I C"
60 PRINT: PRINT " Atari 2600 + PlusCart + KeyPortari"
70 PRINT " 36 x 14 text, 64 KB, integer BASIC"
80 PRINT: PRINT " Free memory: "; SIZE; " bytes"
90 A=150: GOSUB 900
100 REM --- raster bars: one background colour per line
110 FOR P=0 TO 47
120 FOR B=0 TO 29
130 C=((B+P)%16)*16+6
140 FOR Y=B*6 TO B*6+5: POKE 1024+Y, C: NEXT Y
150 NEXT B: NEXT P
160 FOR Y=0 TO 181: POKE 1024+Y, 0: NEXT Y
170 A=30: GOSUB 900
200 REM --- GRAPHICS 8: string art, 145 x 181 pixels
210 GRAPHICS 8+16
220 FOR I=0 TO 180 STEP 6
230 PLOT 0,I: DRAWTO I*4/5,180
240 PLOT 144,180-I: DRAWTO 144-I*4/5,0
250 PLOT I*4/5,0: DRAWTO 0,180-I
260 PLOT 144-I*4/5,180: DRAWTO 144,I
270 NEXT I
280 A=150: GOSUB 900
300 REM --- GRAPHICS 8: frame, diagonals and random stars
310 GRAPHICS 8+16
320 PLOT 0,0: DRAWTO 144,0: DRAWTO 144,180: DRAWTO 0,180: DRAWTO 0,0
330 PLOT 0,0: DRAWTO 144,180: PLOT 144,0: DRAWTO 0,180
340 FOR I=1 TO 300: PLOT RND(143)+1, RND(179)+1: NEXT I
350 A=150: GOSUB 900
400 REM --- GRAPHICS 3: block graphics, colour per row
410 FOR Y=0 TO 181: POKE 1024+Y, B: NEXT Y
420 GRAPHICS 3
430 FOR R=0 TO 10: POKE 128+R*8, R*16+30: NEXT R
435 FOR R=11 TO 13: POKE 256+R, 14: NEXT R
440 FOR X=0 TO 39
450 Y=ABS(X%20-10)
460 PLOT X,Y: DRAWTO X,10
470 NEXT X
480 FOR I=1 TO 12: PRINT: NEXT I
485 PRINT "GRAPHICS 3: 40 x 11 blocks"
490 A=150: GOSUB 900
500 REM --- text, numbers and integer math
510 GRAPHICS 0: CLS
520 FOR R=0 TO 13: POKE 256+R, (R+1)*16+12: NEXT R
530 PRINT "    N   N*N   2^N  SQR(N*1000)"
540 FOR N=1 TO 10
550 PRINT #5, N, N*N, POW(2,N), SQR(N*1000)
560 NEXT N
570 PRINT "1<<8 ="; 1<<8; "  255>>4 ="; 255>>4
580 PRINT "MAP(50,0,100,0,255) ="; MAP(50,0,100,0,255)
590 A=180: GOSUB 900
600 REM --- strings and arrays
610 CLS
620 A$="TinyELF Basic"
630 PRINT A$; " has "; LEN(A$); " letters"
640 PRINT "Backwards: ";
650 FOR I=LEN(A$) TO 1 STEP -1: PUT A$(I,I): NEXT I
660 PRINT: PRINT "Part: "; A$(1,7)
670 PRINT: PRINT "Bubble sort of 10 random numbers:"
680 DIM S(10)
690 FOR I=1 TO 10: S(I)=RND(100): NEXT I
700 GOSUB 800
710 FOR I=1 TO 9
720 FOR J=1 TO 10-I
730 IF S(J)>S(J+1) THEN T=S(J): S(J)=S(J+1): S(J+1)=T
740 NEXT J
750 NEXT I
760 GOSUB 800
770 A=180: GOSUB 900
780 GOTO 1000
800 REM print the array
810 FOR I=1 TO 10: PRINT #3, S(I);: NEXT I
820 PRINT: RETURN
900 REM wait A frames, any key skips
910 T=PEEK(520)
920 GET K: IF K>0 THEN RETURN
930 IF PEEK(520)=T THEN GOTO 920
940 T=PEEK(520): A=A-1
950 IF A>0 THEN GOTO 920
960 RETURN
1000 REM --- sound: TIA audio registers
1010 GRAPHICS 0: CLS
1020 PRINT: PRINT " Sound through the TIA registers"
1030 POKE 21,4: POKE 25,8
1040 FOR F=31 TO 0 STEP -1
1050 POKE 23,F: A=2: GOSUB 900
1060 NEXT F
1070 POKE 25,0
1080 FOR R=0 TO 13: POKE 256+R,14: NEXT R
1090 PRINT: PRINT " That was TinyELF Basic."
1100 PRINT " LIST shows the program, RUN again!"
1105 POKE 652,Q: POKE 653,Z
1110 END
