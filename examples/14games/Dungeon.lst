10 REM DUNGEONS OF EKILEUGOR - TINYELF BASIC PORT
11 REM ORIGINAL (C) 2012-2021 CHRIS PRESSEY, CAT'S EYE TECHNOLOGIES
12 REM BSD 3-CLAUSE LICENSE, SEE EXAMPLES/LICENSE-EKILEUGOR.TXT
13 REM SCREEN: MAP ROWS 1-11 (W X H = 36 X 11), MESSAGE ROW 12, STATUS ROWS 13-14
14 REM KEYS: I J K L OR CURSOR KEYS = MOVE, R = REST, Q = QUAFF POTION, X = EXIT
15 REM W, H = MAP SIZE, NR = NUMBER OF ROOMS, NM = MAX. NUMBER OF SNAKES
16 W=36: H=11: NR=6: NM=12: WH=W*H
17 REM TOKEN BUDGET 150 WHILE PLAYING, 80 WHILE ROOMS ARE BUILT: KEEPS THE TV PICTURE STABLE
18 Q0=PEEK(652): Q1=PEEK(653): POKE 653,0: POKE 652,150
20 DIM MP(WH)
21 DIM R(4*NR)
22 DIM M(3*NM)
30 MH=19: XG=10: HP=MH: DL=1: AU=0: PT=0: XP=0: XL=1: MU=0
40 GOSUB 7000
50 GOTO 100
100 GOSUB 900
110 MU=0: DX=0: DY=0
120 GET K: IF K=0 THEN GOTO 120
130 IF (K=105) OR (K=11) THEN DY=-1: GOTO 500
140 IF (K=106) OR (K=4) OR (K=8) THEN DX=-1: GOTO 500
150 IF (K=107) OR (K=10) THEN DY=1: GOTO 500
160 IF (K=108) OR (K=21) THEN DX=1: GOTO 500
170 IF K=114 THEN GOTO 400
175 IF K=120 THEN LOCATE 1,12: PRINT "BYE": GOTO 690
180 IF (K=113) AND (PT>0) THEN PT=PT-1: MV=RND(6)+2: HP=HP+MV: M$="quaffed for": GOSUB 800: GOTO 190
185 GOTO 100
190 IF HP>MH THEN HP=MH
400 FOR MN=0 TO NM-1
405 IF M(3*MN+3)<=0 THEN GOTO 490
410 X=M(3*MN+1): Y=M(3*MN+2): DX=SGN(HX-X): DY=SGN(HY-Y)
420 GOSUB 4000: IF C=64 THEN GOSUB 600: GOTO 490
430 IF (C=32) OR (C=94) THEN GOTO 460
440 IF RND(10)<3 THEN DX=0: GOTO 420
450 IF RND(10)<3 THEN DY=0: GOTO 420
455 GOTO 490
460 GOSUB 4010: X=X+DX: Y=Y+DY: C=83: GOSUB 9000
470 M(3*MN+1)=X: M(3*MN+2)=Y
490 NEXT MN
495 GOTO 100
500 X=HX: Y=HY: GOSUB 4000
510 IF C=83 THEN GOSUB 700: GOTO 400
520 IF C=36 THEN MV=RND(20)*(1+DL/5)+1: AU=AU+MV: M$="gold:": GOSUB 800: C=32
530 IF C=33 THEN MV=-1: M$="potion": GOSUB 800: PT=PT+1: C=32
540 IF C=62 THEN DL=DL+1: GOSUB 7000: GOTO 100
550 IF C=46 THEN GOSUB 6000: GOTO 500
560 IF C=94 THEN M$="dart trap!": GOSUB 640: C=32
565 IF C<>67 THEN GOTO 570
566 I=RND(10): IF I<2 THEN C=94: GOTO 560
567 IF I<5 THEN M$="locked": MV=-1: GOSUB 800: GOTO 400
568 IF I>8 THEN C=33: GOTO 530
569 C=36: GOTO 520
570 IF C<>32 THEN GOTO 400
580 GOSUB 4010: X=X+DX: Y=Y+DY: C=64: GOSUB 9000: HX=X: HY=Y
590 GOTO 400
600 MV=-1: MX=7-DL/4: IF MX<1 THEN MX=1
605 IF RND(MX)<2 THEN GOTO 630
610 M$="snake misses": GOSUB 800: RETURN
630 M$="snake hits for": GOTO 640
640 DM=RND(4)+1: MV=DM: GOSUB 800
650 HP=HP-DM: IF HP>0 THEN RETURN
660 CLS: PRINT "YOU DIED ON DEPTH ";DL: PRINT "WITH ";AU;" GOLD AT LEVEL ";XL: GOTO 690
690 POKE 652,Q0: POKE 653,Q1: END
700 MN=0
705 IF M(3*MN+3)<=0 THEN GOTO 710
706 IF (M(3*MN+1)=HX+DX) AND (M(3*MN+2)=HY+DY) THEN GOTO 720
710 MN=MN+1: IF MN<NM THEN GOTO 705
715 RETURN
720 MV=-1: IF RND(6)<3 THEN GOTO 730
725 M$="you miss": GOSUB 800: RETURN
730 DM=RND(6)+1: MV=DM: M$="you hit for": GOSUB 800
740 M(3*MN+3)=M(3*MN+3)-DM: XP=XP+RND(3)*DL+1
743 IF XP>XG THEN XL=XL+1: XG=XG*2: MH=MH+RND(8)+2: HP=MH: M$="gain exp,level": MV=XL: GOSUB 800: GOTO 743
745 IF M(3*MN+3)>0 THEN RETURN
750 MV=-1: M$="you killed snake": GOSUB 800
760 X=M(3*MN+1): Y=M(3*MN+2): GOSUB 4010
765 M(3*MN+1)=-1: M(3*MN+2)=-1: M(3*MN+3)=0
770 X=HX: Y=HY: RETURN
800 IF MU<>0 THEN GOSUB 850
810 LOCATE 1,12: PRINT "                                   ";
820 LOCATE 1,12: PRINT M$;" ";
830 IF MV>0 THEN PRINT MV;" ";
840 MU=1: RETURN
850 LOCATE 25,12: PRINT "PRESS A KEY";
855 GET KK: IF KK=0 THEN GOTO 855
860 RETURN
900 LOCATE 1,13: PRINT "HP ";HP;"/";MH;"  LEVEL ";XL;"  XP ";XP;"/";XG;"  ";
910 LOCATE 1,14: PRINT "GOLD ";AU;"  POTIONS ";PT;"  DEPTH ";DL;"    ";
920 RETURN
4000 O=(Y+DY)*W+X+DX+1: C=35: IF (O>0) AND (O<=WH) THEN C=MP(O)
4001 RETURN
4010 C=32: GOSUB 9000: RETURN
6000 DR=-1
6001 FOR I=0 TO NR-1
6010 IF X+DX<R(4*I+1) THEN GOTO 6070
6020 IF X+DX>R(4*I+1)+R(4*I+3) THEN GOTO 6070
6030 IF Y+DY<R(4*I+2) THEN GOTO 6070
6040 IF Y+DY>R(4*I+2)+R(4*I+4) THEN GOTO 6070
6050 DR=I: I=NR-1
6070 NEXT I
6080 IF DR<0 THEN X=X+DX: Y=Y+DY: C=32: GOSUB 9000: RETURN
6090 GOSUB 6100
6095 RETURN
6100 POKE 652,80: FOR XX=R(4*DR+1) TO R(4*DR+1)+R(4*DR+3)
6110 FOR YY=R(4*DR+2) TO R(4*DR+2)+R(4*DR+4)
6120 X=XX: Y=YY: C=32: GOSUB 9000
6130 NEXT YY
6140 NEXT XX
6150 GOSUB 6200
6160 GOSUB 6300
6170 POKE 652,150: RETURN
6200 M1=RND(4)
6210 IF M1=0 THEN RETURN
6220 FOR J=1 TO M1
6230 GOSUB 8000: GOSUB 6500
6240 NEXT J
6250 RETURN
6300 J=RND(3): IF J>0 THEN GOSUB 6310
6302 IF RND(10)>2 THEN GOSUB 8000: C=94: GOSUB 9000
6304 IF RND(10)>4 THEN GOSUB 8000: C=33: GOSUB 9000
6306 IF (R(4*DR+3)>2) AND (RND(10)>5) THEN GOSUB 8000: C=67: GOSUB 9000
6308 IF DR=RS THEN GOSUB 8000: C=62: GOSUB 9000
6309 RETURN
6310 FOR I=1 TO J: GOSUB 8000: C=36: GOSUB 9000: NEXT I
6320 RETURN
6390 RETURN
6500 I=0
6505 IF M(3*I+3)=0 THEN GOTO 6530
6510 I=I+1: IF I<NM THEN GOTO 6505
6520 RETURN
6530 M(3*I+1)=X: M(3*I+2)=Y: M(3*I+3)=RND(6)+DL: C=83: GOSUB 9000
6540 RETURN
7000 CLS: TT=0: POKE 652,80
7005 FOR I=1 TO WH: MP(I)=35: NEXT I
7060 FOR I=0 TO NM-1: M(3*I+1)=-1: M(3*I+2)=-1: M(3*I+3)=0: NEXT I
7100 FOR I=0 TO NR-1
7110 R(4*I+3)=2*RND(4)+2: R(4*I+4)=2*RND(2)+2
7120 R(4*I+1)=2*RND((W-R(4*I+3))/2)+1
7125 R(4*I+2)=2*RND((H-R(4*I+4))/2)+1
7130 IF I=0 THEN GOTO 7490
7140 OL=0: FOR J=0 TO I-1: GOSUB 7200: IF OL=1 THEN J=I
7145 GOTO 7295
7200 OL=0
7201 A=4*I+1: B=4*J+1
7202 IF R(A)>R(B)+R(B+2) THEN RETURN
7203 IF R(B)>R(A)+R(A+2) THEN RETURN
7204 IF R(A+1)>R(B+1)+R(B+3) THEN RETURN
7205 IF R(B+1)>R(A+1)+R(A+3) THEN RETURN
7206 OL=1: RETURN
7295 NEXT J
7300 IF OL=1 THEN TT=TT+1: IF TT<300 THEN GOTO 7110
7310 IF OL=1 THEN GOTO 7000
7400 DR=RND(I): RX=RND(R(4*I+3))+R(4*I+1): RY=RND(R(4*DR+4))+R(4*DR+2)
7420 X=RX: Y=R(4*I+2)
7430 GOSUB 4010: IF Y<>RY THEN Y=Y+SGN(RY-Y): GOTO 7430
7450 GOSUB 4010: IF X<>R(4*DR+1) THEN X=X+SGN(R(4*DR+1)-X): GOTO 7450
7490 NEXT I
7500 FOR I=0 TO NR-1
7505 FOR XX=R(4*I+1) TO R(4*I+1)+R(4*I+3)
7510 FOR YY=R(4*I+2) TO R(4*I+2)+R(4*I+4)
7515 X=XX: Y=YY: C=46: GOSUB 9000
7520 NEXT YY
7525 NEXT XX
7530 NEXT I
7900 RS=RND(NR)
7910 DR=RND(NR): GOSUB 6100: GOSUB 8000: HX=X: HY=Y: C=64: GOSUB 9000
7950 POKE 652,80: FOR Y=0 TO H-1: FOR X=0 TO W-1: LOCATE X+1,Y+1: PUT MP(Y*W+X+1): NEXT X: NEXT Y
7960 POKE 652,150: RETURN
8000 TR=0
8010 X=RND(R(4*DR+3)+1)+R(4*DR+1): Y=RND(R(4*DR+4)+1)+R(4*DR+2): DX=0: DY=0: GOSUB 4000: TR=TR+1
8020 IF (C<>32) AND (TR<40) THEN GOTO 8010
8030 RETURN
9000 O=Y*W+X+1: MP(O)=C: LOCATE X+1,Y+1: PUT C: RETURN
