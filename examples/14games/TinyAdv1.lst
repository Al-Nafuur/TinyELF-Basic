10 REM TINYELF ADVENTURE 0.1
20 REM THE OLD CASTLE
30 GRAPHICS 0: CLS
40 PRINT "THE OLD CASTLE"
50 PRINT
60 PRINT "FIND THE TREASURE"
70 PRINT "AND ESCAPE!"
80 PRINT
90 PRINT "PRESS ANY KEY"
100 GOSUB 9000
110 R=0: Y=0: Z=0
120 GOTO 1000

1000 REM ROOM SELECT
1010 CLS
1020 IF R=0 THEN GOTO 1100
1030 IF R=1 THEN GOTO 1200
1040 IF R=2 THEN GOTO 1300
1050 IF R=3 THEN GOTO 1400
1060 IF R=4 THEN GOTO 1500
1070 GOTO 1100

1100 REM COURTYARD
1110 PRINT "COURTYARD"
1120 PRINT
1130 PRINT "AN OLD CASTLE"
1140 PRINT "STANDS BEFORE YOU."
1150 PRINT
1160 PRINT "1 ENTER CASTLE"
1170 PRINT "2 LEAVE"
1180 PRINT "4 INVENTORY"
1190 PRINT "9 QUIT"
1191 GET X: IF X=0 THEN GOTO 1191
1192 IF X=49 THEN R=1: GOTO 1000
1193 IF X=50 THEN GOTO 2100
1194 IF X=52 THEN GOSUB 5000: GOTO 1100
1195 IF X=57 THEN GOTO 8000
1196 GOTO 1100

1200 REM ENTRANCE HALL
1210 PRINT "ENTRANCE HALL"
1220 PRINT
1230 PRINT "A DUSTY HALL"
1240 PRINT "LEADS DEEP INSIDE."
1250 PRINT
1260 PRINT "1 COURTYARD"
1270 PRINT "2 LIBRARY"
1280 PRINT "3 CELLAR"
1290 PRINT "4 INVENTORY"
1291 PRINT "9 QUIT"
1292 GET X: IF X=0 THEN GOTO 1292
1293 IF X=49 THEN R=0: GOTO 1000
1294 IF X=50 THEN R=2: GOTO 1000
1295 IF X=51 THEN R=3: GOTO 1000
1296 IF X=52 THEN GOSUB 5000: GOTO 1200
1297 IF X=57 THEN GOTO 8000
1298 GOTO 1200

1300 REM LIBRARY
1310 PRINT "OLD LIBRARY"
1320 PRINT
1330 PRINT "DUSTY BOOKS COVER"
1340 PRINT "THE WALLS."
1350 PRINT
1360 IF Y=1 THEN PRINT "YOU HAVE THE KEY."
1370 IF Y=0 THEN PRINT "A SMALL KEY IS HERE."
1380 PRINT
1390 PRINT "1 RETURN TO HALL"
1391 PRINT "2 SEARCH BOOKS"
1392 PRINT "4 INVENTORY"
1393 PRINT "9 QUIT"
1394 GET X: IF X=0 THEN GOTO 1394
1395 IF X=49 THEN R=1: GOTO 1000
1396 IF X=50 THEN GOTO 3000
1397 IF X=52 THEN GOSUB 5000: GOTO 1300
1398 IF X=57 THEN GOTO 8000
1399 GOTO 1300

1400 REM CELLAR
1410 PRINT "DARK CELLAR"
1420 PRINT
1430 PRINT "IT IS VERY DARK."
1440 IF Y=1 THEN PRINT "YOU FEEL A DOOR."
1450 PRINT
1460 PRINT "1 RETURN TO HALL"
1470 PRINT "2 SEARCH"
1480 PRINT "4 INVENTORY"
1490 PRINT "9 QUIT"
1491 GET X: IF X=0 THEN GOTO 1491
1492 IF X=49 THEN R=1: GOTO 1000
1493 IF X=50 THEN GOTO 3100
1494 IF X=52 THEN GOSUB 5000: GOTO 1400
1495 IF X=57 THEN GOTO 8000
1496 GOTO 1400

1500 REM TREASURE ROOM
1510 PRINT "TREASURE ROOM"
1520 PRINT
1530 PRINT "A GOLDEN CHEST"
1540 PRINT "STANDS HERE."
1550 PRINT
1560 IF Z=1 THEN GOTO 1580
1570 PRINT "1 OPEN CHEST"
1571 PRINT "2 RETURN"
1572 PRINT "4 INVENTORY"
1573 PRINT "9 QUIT"
1574 GET X: IF X=0 THEN GOTO 1574
1575 IF X=49 THEN GOTO 3200
1576 IF X=50 THEN R=3: GOTO 1000
1577 IF X=52 THEN GOSUB 5000: GOTO 1500
1578 IF X=57 THEN GOTO 8000
1579 GOTO 1500
1580 PRINT "THE CHEST IS EMPTY."
1581 PRINT "THE TREASURE IS YOURS."
1582 PRINT
1583 PRINT "1 RETURN"
1584 PRINT "4 INVENTORY"
1585 PRINT "9 QUIT"
1586 GET X: IF X=0 THEN GOTO 1586
1587 IF X=49 THEN R=3: GOTO 1000
1588 IF X=52 THEN GOSUB 5000: GOTO 1500
1589 IF X=57 THEN GOTO 8000
1590 GOTO 1500

2100 REM LEAVE CASTLE
2110 CLS
2120 IF Z=1 THEN GOTO 2300
2130 PRINT "YOU LEAVE THE"
2140 PRINT "CASTLE."
2150 PRINT
2160 PRINT "BUT THE TREASURE"
2170 PRINT "IS STILL INSIDE."
2180 PRINT
2190 PRINT "PRESS ANY KEY"
2191 GOSUB 9000
2192 R=0
2193 GOTO 1000

2300 REM WIN
2310 CLS
2320 PRINT "YOU ESCAPED!"
2330 PRINT
2340 PRINT "THE GOLDEN"
2350 PRINT "TREASURE IS YOURS."
2360 PRINT
2370 PRINT "CONGRATULATIONS!"
2380 PRINT
2390 PRINT "THE END"
2400 END

3000 REM SEARCH LIBRARY
3010 CLS
3020 IF Y=1 THEN GOTO 3075
3030 PRINT "YOU SEARCH THE"
3040 PRINT "BOOKS CAREFULLY."
3050 PRINT
3060 PRINT "YOU FIND AN IRON"
3061 PRINT "KEY!"
3062 Y=1
3070 PRINT
3071 PRINT "YOU TAKE THE KEY."
3072 GOSUB 9000
3073 GOTO 1300
3075 PRINT "YOU SEARCH AGAIN."
3076 PRINT "NOTHING ELSE HERE."
3077 GOSUB 9000
3078 GOTO 1300

3100 REM SEARCH CELLAR
3110 CLS
3120 IF Y=1 THEN GOTO 3150
3130 PRINT "YOU FEEL AROUND"
3140 PRINT "IN THE DARK."
3141 PRINT
3142 PRINT "YOU FIND NOTHING."
3143 GOSUB 9000
3144 GOTO 1400
3150 PRINT "YOU FIND A SMALL"
3160 PRINT "LOCKED DOOR."
3170 PRINT
3180 PRINT "THE KEY FITS!"
3190 PRINT "THE DOOR OPENS."
3191 GOSUB 9000
3192 R=4
3193 GOTO 1000

3200 REM OPEN CHEST
3210 CLS
3220 IF Y=1 THEN GOTO 3250
3230 PRINT "THE CHEST IS LOCKED."
3240 GOSUB 9000
3241 GOTO 1500
3250 PRINT "THE KEY OPENS"
3260 PRINT "THE GOLDEN CHEST."
3270 PRINT
3280 PRINT "INSIDE IS A"
3290 PRINT "GOLDEN TREASURE!"
3300 PRINT
3310 PRINT "1 TAKE TREASURE"
3320 PRINT "2 LEAVE IT"
3330 GET X: IF X=0 THEN GOTO 3330
3340 IF X=49 THEN Z=1: GOTO 3400
3350 IF X=50 THEN GOTO 1500
3360 GOTO 3200

3400 REM TREASURE TAKEN
3410 CLS
3420 PRINT "YOU TAKE THE"
3430 PRINT "GOLDEN TREASURE!"
3440 PRINT
3450 PRINT "NOW ESCAPE!"
3460 PRINT
3470 PRINT "PRESS ANY KEY"
3480 GOSUB 9000
3490 GOTO 1500

5000 REM INVENTORY
5010 CLS
5020 PRINT "INVENTORY"
5030 PRINT
5040 IF Y=0 THEN PRINT "KEY: NO"
5050 IF Y=1 THEN PRINT "KEY: YES"
5060 IF Z=0 THEN PRINT "TREASURE: NO"
5070 IF Z=1 THEN PRINT "TREASURE: YES"
5080 PRINT
5090 PRINT "PRESS ANY KEY"
5100 GOSUB 9000
5110 RETURN

8000 REM QUIT
8010 CLS
8020 PRINT "GOODBYE!"
8030 END

9000 REM WAIT FOR KEY
9010 GET X: IF X>0 THEN RETURN
9020 GOTO 9010
